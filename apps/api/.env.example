# SherERP API — environment template
#
# Copy to `apps/api/.env` and fill in real values. The API does NOT auto-load
# this file: it is started with `node --env-file=.env dist/main.js`.
#
# NEVER commit a filled-in .env. Only NAMES belong in this file — no password,
# token, key or connection string with real credentials in it.

# ---------------------------------------------------------------------------
# Required — the process refuses to boot without these (src/config.ts)
# ---------------------------------------------------------------------------

# PostgreSQL connection string for the application role.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Secret that signs access tokens. Long and random; rotating it signs everyone
# out. There is deliberately no default — a fallback secret is a shipped hole.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the API listens on. Default 3000.
PORT=3000

# The single origin the browser app is served from. CORS allows this and
# nothing else, so a wrong value shows as a dead network, not as an error.
# Default http://localhost:5173
WEB_ORIGIN=http://localhost:5173

# Standard Node environment. `production` turns the §4.4 boot refusals from
# warnings into hard failures.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Deployment mode (D-33 … D-36, §4.4)
# ---------------------------------------------------------------------------

# One installation, one business. Default false.
SINGLE_TENANT_MODE=false

# How a new identity is verified: dev | otp | none. Default dev.
#   dev  — accepts anything; REFUSED at boot under NODE_ENV=production.
#   otp  — SMS/email one-time code; NOT IMPLEMENTED (no transport chosen).
#   none — self-hosted, nobody to verify against.
IDENTITY_VERIFIER=dev

# Where entitlement comes from: license | subscription. Default license.
# `subscription` is the permissive SaaS stub and must be asked for by name.
ENTITLEMENT_SOURCE=license

# ---------------------------------------------------------------------------
# Licence (Phase 10) — public key material only; the PRIVATE key never
# lives on a customer machine and never in this repository.
# ---------------------------------------------------------------------------

# Where the installed licence file is read from and written to.
# Default licence/sher.licence
LICENSE_KEY_PATH=licence/sher.licence

# The anti-rollback high-water mark. Must NOT sit inside a backup or a restore
# could wind the licence clock back. Default <LICENSE_KEY_PATH>.state.json
LICENSE_STATE_PATH=

# Comma-separated PUBLIC keys the installation will trust, in the tool's
# encoding. Public by nature — safe in an env file, safe in a deployment
# manifest. Empty means: trust only the key embedded in the build.
LICENSE_TRUSTED_KEYS=

# A single trusted PUBLIC key, overriding the one embedded in the build.
LICENSE_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Messaging and billing
# ---------------------------------------------------------------------------

# SMS transport. Default none. No provider has been chosen (§5.24).
SMS_PROVIDER=none

# Whether billing screens are offered. Default true.
BILLING_ENABLED=true

# Google OAuth client id for sign-in (D-07). A PUBLIC identifier — it ships to
# every browser. Empty disables Google sign-in.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Backup and recovery (§5.25)
# ---------------------------------------------------------------------------

# Directory the encrypted .sherdb backups are written to. Default backups
BACKUP_DIR=backups

# File holding the backup encryption key. Empty derives it from the operator's
# password at backup time. If set, this file is a SECRET — keep it out of git
# and off the backup medium itself.
BACKUP_KEY_PATH=

# Where a recovery dump is expanded. Default backups/recovery
RECOVERY_DUMP_DIR=backups/recovery

# Hour of the day (0–23, tenant local) the scheduled backup runs. Default 2
BACKUP_HOUR=2

# ---------------------------------------------------------------------------
# Tests only — not read by the running API
# ---------------------------------------------------------------------------

# Database the API integration suite creates and truncates. NEVER point this at
# a database holding real books; the suite wipes it.
TEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_test

# Superuser connection used once to create the test role/database.
ADMIN_DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
