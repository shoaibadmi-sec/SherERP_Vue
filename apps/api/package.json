{
  "name": "@sher/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm --filter \"@sher/api...\" build && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/migrate.js",
    "db:backfill": "node dist/backfill-seed-roles.js",
    "db:upgrade": "node dist/upgrade.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@sher/adapter-postgres": "workspace:*",
    "@sher/core-application": "workspace:*",
    "@sher/core-contracts": "workspace:*",
    "@sher/shared-utils": "workspace:*",
    "express": "4.21.2",
    "pdfjs-dist": "^6.3.289",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/node": "20.19.9",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
