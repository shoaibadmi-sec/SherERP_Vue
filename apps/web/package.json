    "@sher/core-domain": "workspace:*",
    "@sher/shared-utils": "workspace:*",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "html2canvas-pro": "^2.4.0",
    "primeicons": "7.0.0",
    "primevue": "4.3.3",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/pg": "8.11.10",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.6",
    "jsdom": "25.0.1",
    "pg": "8.13.1",
    "typescript": "5.7.3",
    "vite": "5.4.21",
    "vitest": "2.1.8",
    "vue-tsc": "2.2.0"
